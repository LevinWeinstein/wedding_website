:root {
  --bg-primary: #F9F1EB;
  --text-olive: #767032;
  --text-light: #8C8C8C;
  --accent-olive: #707040;
  --font-serif: 'Playfair Display', serif;
  --font-hand: 'Homemade Apple', cursive;
  --font-sans: 'Quicksand', sans-serif;
  --border-color: #D9D2C9;
}

body {
  background-color: var(--bg-primary);
  color: var(--text-olive);
  font-family: var(--font-sans);
  margin: 0;
  padding: 0;
  background-image: url('/images/photo_1.jpg');
  background-size: 100% auto;
  background-repeat: no-repeat;
  background-position: top center;
}

.app-container {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  padding: 2rem;
}

/* Floral Border Frame */
.border-frame {
  max-width: 1400px;
  width: 100%;
  padding: 26rem 4rem 4rem 4rem;
  /* Even more padding to clear the background bow */
  margin: 0 auto;
  position: relative;
}

.content-wrapper {
  text-align: center;
}

.header {
  margin-bottom: 6rem;
  /* Increased space below header */
}

.header-top {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  margin-bottom: 1.5rem;
}

.our-wedding {
  font-size: 1rem;
  letter-spacing: 2px;
  font-weight: 500;
  color: var(--text-olive);
}

.bow-icon {
  height: 120px;
  /* Larger to show the "Our Wedding" text clearly */
  width: auto;
  margin-bottom: 0.5rem;
}

.names-title {
  font-family: var(--font-hand);
  font-size: 3.2rem;
  font-weight: 400;
  margin-top: -1rem;
  margin-bottom: 2rem;
  color: #767032cc;
}

.header-details p {
  font-size: 0.8rem;
  letter-spacing: 1px;
  color: var(--text-olive);
  margin: 0.2rem 0;
}

/* Navigation Tabs */
.tab-nav {
  display: flex;
  justify-content: center;
  gap: 3.5rem;
  /* Wider gap between links */
  margin-bottom: 6rem;
  /* More space before content */
  padding-bottom: 1.5rem;
}

.nav-link {
  background: none;
  border: none;
  font-family: inherit;
  font-size: 0.9rem;
  color: var(--text-olive);
  cursor: pointer;
  text-transform: capitalize;
  padding: 0.5rem 0;
  position: relative;
  transition: opacity 0.3s ease;
}

.nav-link:hover {
  opacity: 0.7;
}

.nav-link.active::after {
  content: '';
  position: absolute;
  bottom: -0.5rem;
  left: -20%;
  /* Wider than text */
  width: 140%;
  height: 1.5px;
  background: var(--text-olive);
}

/* Home Pane */
.home-info-grid {
  display: flex;
  justify-content: center;
  align-items: center;
  max-width: 900px;
  margin: 4rem auto 6rem auto;
}

.info-item {
  flex: 1;
  display: flex;
  justify-content: center;
}

.handwritten {
  font-family: var(--font-hand);
  font-size: 2.6rem;
  font-weight: 400;
  line-height: 1.1;
  text-align: center;
  color: #767032cc; /* Softer weight through transparency */
}

.divider {
  width: 1px;
  /* Thinner line */
  height: 250px;
  /* Much longer */
  background: var(--text-olive);
  margin: 0 2rem;
  opacity: 0.6;
  /* Slightly softer */
}

.rsvp-hero-btn {
  background: #707040;
  color: white;
  border: none;
  padding: 0.8rem 2rem;
  font-size: 0.9rem;
  letter-spacing: 2px;
  font-weight: 500;
  cursor: pointer;
  margin-top: 1rem;
  margin-bottom: 4rem;
  transition: transform 0.2s ease;
  text-transform: uppercase;
}

.rsvp-hero-btn:hover {
  transform: scale(1.05);
}

.wedding-day-summary {
  max-width: 800px;
  margin: 0 auto;
}

.wedding-day-summary h3 {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  letter-spacing: 3px;
  font-weight: 400;
  margin-bottom: 1rem;
}

.summary-date {
  font-size: 1rem;
  letter-spacing: 2px;
  margin-bottom: 2rem;
}

.summary-hr {
  border: none;
  border-top: 1px solid var(--text-olive);
  margin: 2rem 0;
  opacity: 0.5;
}

.ceremony-details h4 {
  font-family: var(--font-serif);
  font-size: 1.2rem;
  letter-spacing: 2px;
  margin-bottom: 1rem;
}

.ceremony-details p {
  font-size: 0.95rem;
  color: var(--text-olive);
  margin: 0.3rem 0;
}

/* Story Pane */
.story-pane {
  max-width: 900px;
  margin: 0 auto;
  text-align: center;
}

.story-title {
  font-family: var(--font-serif);
  font-size: 1.8rem;
  letter-spacing: 2px;
  margin-bottom: 3rem;
  line-height: 1.4;
}

.story-image-container {
  margin-bottom: 3rem;
}

.main-story-image {
  width: 100%;
  border-radius: 4px;
}

.story-verbatim-text {
  text-align: left;
  line-height: 1.8;
  font-size: 1.1rem;
}

.story-verbatim-text p {
  margin-bottom: 1.5rem;
}

/* Photos Pane */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
  gap: 1rem;
}

.gallery-item img {
  width: 100%;
  height: 300px;
  object-fit: cover;
  border-radius: 4px;
}

@media (max-width: 768px) {
  .home-info-grid {
    flex-direction: column;
    gap: 1rem;
  }

  .divider {
    display: none;
  }

  .names-title {
    font-size: 3rem;
  }
}